import { useState, type FormEvent, type ReactNode } from 'react'
import {
  ArrowRight,
  Eye,
  EyeOff,
  LoaderCircle,
  LockKeyhole,
  Mail,
  MessageCircle,
  Package,
  ShieldCheck,
  TrendingUp,
  Wallet,
} from 'lucide-react'
import { setAuthSessionPersistence, supabase } from '../lib/supabase'

function Feature({
  icon,
  title,
  description,
}: {
  icon: ReactNode
  title: string
  description: ReactNode
}) {
  return (
    <div className="min-w-0">
      <div className="mb-3 flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-400 text-emerald-300">
        {icon}
      </div>
      <h3 className="text-base font-semibold text-white">{title}</h3>
      <p className="mt-1 text-sm leading-5 text-emerald-50/80">
        {description}
      </p>
    </div>
  )
}

